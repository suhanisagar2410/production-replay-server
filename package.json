{
  "name": "production-replay-server",
  "version": "1.0.0",
  "description": "API Server & SDK for Production Replay",
  "main": "dist/index.js",
  "scripts": {
    "dev": "nodemon --watch src -e ts --exec ts-node src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "start:demo": "ts-node src/demo-app.ts",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev --name init"
  },
